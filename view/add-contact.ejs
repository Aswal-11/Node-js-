<%- include('partials/header.ejs') %>
    <!-- Navbar -->
    <nav class="bg-white shadow">
      <div class="max-w-6xl mx-auto px-4 py-4">
        <a
          href="index.html"
          class="text-2xl font-bold uppercase text-blue-600 tracking-wide"
        >
          <strong>Contact</strong> App
        </a>
      </div>
    </nav>

    <!-- Content -->
    <main class="py-10">
      <div class="max-w-3xl mx-auto px-4">
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
          <div
            class="border-b border-gray-200 px-6 py-4 bg-gray-100 font-semibold text-gray-700"
          >
            Add New Contact
          </div>
          <div class="p-6">
            <form class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label
                  for="first_name"
                  class="font-medium text-gray-700 md:text-right"
                  >First Name</label
                >
                <div class="md:col-span-2">
                  <input
                    type="text"
                    id="first_name"
                    name="first_name"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label
                  for="last_name"
                  class="font-medium text-gray-700 md:text-right"
                  >Last Name</label
                >
                <div class="md:col-span-2">
                  <input
                    type="text"
                    id="last_name"
                    name="last_name"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label
                  for="email"
                  class="font-medium text-gray-700 md:text-right"
                  >Email</label
                >
                <div class="md:col-span-2">
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                <label
                  for="phone"
                  class="font-medium text-gray-700 md:text-right"
                  >Phone</label
                >
                <div class="md:col-span-2">
                  <input
                    type="text"
                    id="phone"
                    name="phone"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
                <label
                  for="address"
                  class="font-medium text-gray-700 md:text-right pt-2"
                  >Address</label
                >
                <div class="md:col-span-2">
                  <textarea
                    id="address"
                    name="address"
                    rows="3"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
                  ></textarea>
                </div>
              </div>

              <div class="border-t border-gray-200 pt-6">
                <div class="md:col-span-3 flex justify-end space-x-3">
                  <button
                    type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition"
                  >
                    Save
                  </button>
                  <a
                    href="index.html"
                    class="border border-gray-400 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-100 transition"
                    >Cancel</a
                  >
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

<%- include('partials/footer.ejs') %>
