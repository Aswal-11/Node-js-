<%- include('header') %>

    <h1 class="text-center font-semibold text-yellow-300 text-3xl p-3"><%= title %></h1>
    <p class="text-center font-semibold text-xl"><%= content%></p>
    
    <% if(message){
        %>
        <p class="text-center"><%= message %></p>
        <%
    }else{
        %>
        <span>Theres is no message</span>
        <%
    }
    %>

    <!-- print the array -->
    <ul class="text-center">
    <% items.forEach(item => { %>
        <li class="font-semibold"><%= item.name %> and <%= item.color %></li>
    <% }) %>
    </ul>

   <div class="flex justify-center p-4">
        <table class="table-auto border-collapse border-spacing-x-8 border-2">
            <thead>
            <tr class="border-b-2">
                <th class="px-8 py-2">Name</th>
                <th class="px-8 py-2">Color</th>
                <th class="px-8 py-2">Location</th>
            </tr>
            </thead>
            <tbody>
            <% items.forEach(item => { %>
                <tr class="border-b-2">
                <td class="px-8 py-2 text-center"><%= item.name %></td>
                <td class="px-8 py-2 text-center"><%= item.color %></td>
                <td class="px-8 py-2 text-center"><%= item.location %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>

<%- include('footer') %>


