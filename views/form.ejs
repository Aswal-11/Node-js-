<%- include('partials/header.ejs') %>

    <main class="py-5">
        <div class="container">
            <div class="row justify-content-md-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header card-title">
                            <strong>Add New Contact</strong>
                        </div>
                        <form action="/submit-form" method="post">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group row">
                                            <label for="username" class="col-md-3 col-form-label">Username</label>
                                            <div class="col-md-9">
                                                <input type="text" name="username" id="username" class="form-control">
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <label for="useremail" class="col-md-3 col-form-label">Email</label>
                                            <div class="col-md-9">
                                                <input type="text" name="useremail" id="useremail" class="form-control">
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <label for="userpassword" class="col-md-3 col-form-label">Password</label>
                                            <div class="col-md-9">
                                                <input type="password" name="userpassword" id="userpassword"
                                                    class="form-control">
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <label for="userage" class="col-md-3 col-form-label">Age</label>
                                            <div class="col-md-9">
                                                <input type="text" name="userage" id="userage" class="form-control">
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="form-group row mb-0">
                                            <div class="col-md-9 offset-md-3">
                                                <button type="submit" class="btn btn-primary">Save</button>
                                                <a href="/" class="btn btn-outline-secondary">Cancel</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
<%- include('partials/footer.ejs') %>